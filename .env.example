# SQLite database used by Prisma (decks, cards, cached prices)
DATABASE_URL="file:./prisma/dev.db"

# Supabase accounts. Leave empty to run MTGDT in single-user "local mode".
# Supabase dashboard > Project Settings > API (or "Connect"): Project URL and publishable (anon) key.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Optional: the public URL of the site, used in confirmation / reset emails.
# Defaults to the address the request came in on (e.g. http://localhost:3000).
NEXT_PUBLIC_SITE_URL=""
